CC = gcc
CFLAGS = -Wall -O2
TARGET = monitor_test_v3
VICTIM_SRC = victim.c
VICTIM_BIN = victim_bin

all: $(TARGET)

$(TARGET): monitor_test_v3.c
	$(CC) $(CFLAGS) monitor_test_v3.c -o $(TARGET)

# Clean only the files generated by this test suite
clean:
	rm -f $(TARGET) $(VICTIM_BIN) $(VICTIM_SRC) ebpf_test_file.txt
	rm -rf ebpf_test_dir
